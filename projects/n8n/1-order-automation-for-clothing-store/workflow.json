            ]}, "requiredField": true },
            { "fieldLabel": "Commune", "fieldName": "Commune", "placeholder": "ex: Draria", "requiredField": true },
            { "fieldLabel": "Address", "fieldName": "Address", "placeholder": "Street, cité, building", "requiredField": true },
            { "fieldLabel": "Product", "fieldName": "Product", "placeholder": "Outfit name or reference", "requiredField": true },
            { "fieldLabel": "Size", "fieldType": "dropdown", "fieldName": "Size", "fieldOptions": { "values": [
              { "option": "S" }, { "option": "M" }, { "option": "L" }, { "option": "XL" }, { "option": "2XL" }, { "option": "3XL" }
