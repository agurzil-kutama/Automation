            { "fieldLabel": "Color", "fieldName": "Color", "placeholder": "ex: Black", "requiredField": true },
            { "fieldLabel": "Quantity", "fieldType": "number", "fieldName": "Quantity", "placeholder": "1", "requiredField": true },
